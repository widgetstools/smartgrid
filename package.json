{
  "name": "smartgrid",
  "private": true,
  "version": "0.0.0",
  "description": "AI-first configuration layer for AG Grid Enterprise with a lean schema-driven fallback UI",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev": "npm run dev --workspace=@smartgrid/playground",
    "clean": "rimraf --glob \"packages/*/dist\" \"apps/*/dist\" .turbo"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.4.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0"
  }
}
