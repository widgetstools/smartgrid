{
  "name": "@smartgrid/forms",
  "version": "0.0.0",
  "description": "JSON-Schema-driven form renderer that resolves x-editor hints through the EditorRegistry; the customizer's fallback UI when the assistant is unavailable",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartgrid/editors": "0.0.0",
    "@smartgrid/schema": "0.0.0",
    "@smartgrid/ui": "0.0.0",
    "lucide-react": "1.41.0",
    "zod": "4.5.4"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
