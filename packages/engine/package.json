{
  "name": "@smartgrid/engine",
  "version": "0.0.0",
  "description": "Turns the SmartGrid config document into AG Grid column definitions, grid options and runtime behaviours",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartgrid/design-system": "0.0.0",
    "@smartgrid/expressions": "0.0.0",
    "@smartgrid/schema": "0.0.0"
  },
  "peerDependencies": {
    "ag-grid-community": "^36.1.0"
  },
  "devDependencies": {
    "ag-grid-community": "36.1.0",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
