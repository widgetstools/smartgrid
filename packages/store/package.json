{
  "name": "@smartgrid/store",
  "version": "0.0.0",
  "description": "StorageAdapter contract with IndexedDB and memory adapters, profiles, patch log and migrations for the SmartGrid config document",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@smartgrid/schema": "0.0.0",
    "fast-json-patch": "3.1.1",
    "idb": "8.0.3"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5",
    "rimraf": "6.1.3",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
